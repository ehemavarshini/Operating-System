#include <stdio.h>
#include "head.h"

int main() {
    struct Process p[20];
    int n, i, choice, quantum;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    for (i = 0; i < n; i++) {
        p[i].pid = i + 1;
        printf("P[%d] AT, BT, & Priority: ", i + 1);
        scanf("%d %d %d", &p[i].at, &p[i].bt, &p[i].priority);
    }

    while (1) {
        printf("\n--- Scheduling Menu ---\n");
        printf("1. FCFS\n2. SJF\n3. SRTF\n4. Priority Preemptive\n5. Round Robin\n6. Exit\nChoice: ");
        scanf("%d", &choice);

        if (choice == 1) fcfs(p, n);
        else if (choice == 2) sjf(p, n);
        else if (choice == 3) srtf(p, n);
        else if (choice == 4) priority_preemptive(p, n);
        else if (choice == 5) {
            printf("Enter Time Quantum: ");
            scanf("%d", &quantum);
            round_robin(p, n, quantum);
        }
        else break;
    }
    return 0;
}
