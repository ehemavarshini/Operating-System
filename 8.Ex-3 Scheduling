#include <stdio.h>
#include "head.h"

/* --- FCFS --- */
void fcfs(struct Process p[], int n) {
    int i;
    float avg_wt = 0, avg_tat = 0;
    int current_time = 0;
    for (i = 0; i < n; i++) {
        if (current_time < p[i].at) current_time = p[i].at;
        p[i].ct = current_time + p[i].bt;
        p[i].tat = p[i].ct - p[i].at;
        p[i].wt = p[i].tat - p[i].bt;
        current_time = p[i].ct;
        avg_tat += p[i].tat;
        avg_wt += p[i].wt;
        printf("P[%d]\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt);
    }
    printf("Avg TAT: %.2f, Avg WT: %.2f\n", avg_tat / n, avg_wt / n);
}

/* --- SJF Non-Preemptive --- */
void sjf(struct Process p[], int n) {
    int count = 0, time = 0, i, shortest, min_bt;
    int is_completed[20] = {0};
    float avg_wt = 0, avg_tat = 0;
    printf("\n--- SJF Results ---\nProcess\tAT\tBT\tCT\tTAT\tWT\n");
    while (count != n) {
        shortest = -1; min_bt = 9999;
        for (i = 0; i < n; i++) {
            if (p[i].at <= time && !is_completed[i] && p[i].bt < min_bt) {
                min_bt = p[i].bt;
                shortest = i;
            }
        }
        if (shortest == -1) time++;
        else {
            p[shortest].ct = time + p[shortest].bt;
            p[shortest].tat = p[shortest].ct - p[shortest].at;
            p[shortest].wt = p[shortest].tat - p[shortest].bt;
            avg_tat += p[shortest].tat; avg_wt += p[shortest].wt;
            is_completed[shortest] = 1; time = p[shortest].ct; count++;
            printf("P[%d]\t%d\t%d\t%d\t%d\t%d\n", p[shortest].pid, p[shortest].at, p[shortest].bt, p[shortest].ct, p[shortest].tat, p[shortest].wt);
        }
    }
    printf("Avg TAT: %.2f, Avg WT: %.2f\n", avg_tat / n, avg_wt / n);
}

/* --- SRTF Preemptive --- */
void srtf(struct Process p[], int n) {
    int count = 0, time = 0, i, shortest, min_bt;
    float avg_wt = 0, avg_tat = 0;
    for (i = 0; i < n; i++) p[i].temp_bt = p[i].bt;
    printf("\n--- SRTF Results ---\nProcess\tAT\tBT\tCT\tTAT\tWT\n");
    while (count != n) {
        shortest = -1; min_bt = 9999;
        for (i = 0; i < n; i++) {
            if (p[i].at <= time && p[i].temp_bt > 0 && p[i].temp_bt < min_bt) {
                min_bt = p[i].temp_bt; shortest = i;
            }
        }
        if (shortest == -1) time++;
        else {
            p[shortest].temp_bt--;
            if (p[shortest].temp_bt == 0) {
                count++;
                p[shortest].ct = time + 1;
                p[shortest].tat = p[shortest].ct - p[shortest].at;
                p[shortest].wt = p[shortest].tat - p[shortest].bt;
                avg_tat += p[shortest].tat; avg_wt += p[shortest].wt;
                printf("P[%d]\t%d\t%d\t%d\t%d\t%d\n", p[shortest].pid, p[shortest].at, p[shortest].bt, p[shortest].ct, p[shortest].tat, p[shortest].wt);
            }
            time++;
        }
    }
    printf("Avg TAT: %.2f, Avg WT: %.2f\n", avg_tat / n, avg_wt / n);
}

/* --- Priority Preemptive --- */
void priority_preemptive(struct Process p[], int n) {
    int count = 0, time = 0, i, highest, min_prio;
    float avg_wt = 0, avg_tat = 0;
    for (i = 0; i < n; i++) p[i].temp_bt = p[i].bt;
    printf("\n--- Priority Preemptive Results ---\nPID\tAT\tBT\tPrio\tCT\tTAT\tWT\n");
    while (count != n) {
        highest = -1; min_prio = 9999;
        for (i = 0; i < n; i++) {
            if (p[i].at <= time && p[i].temp_bt > 0 && p[i].priority < min_prio) {
                min_prio = p[i].priority; highest = i;
            }
        }
        if (highest == -1) time++;
        else {
            p[highest].temp_bt--;
            if (p[highest].temp_bt == 0) {
                count++;
                p[highest].ct = time + 1;
                p[highest].tat = p[highest].ct - p[highest].at;
                p[highest].wt = p[highest].tat - p[highest].bt;
                avg_tat += p[highest].tat; avg_wt += p[highest].wt;
                printf("P[%d]\t%d\t%d\t%d\t%d\t%d\t%d\n", p[highest].pid, p[highest].at, p[highest].bt, p[highest].priority, p[highest].ct, p[highest].tat, p[highest].wt);
            }
            time++;
        }
    }
    printf("Avg TAT: %.2f, Avg WT: %.2f\n", avg_tat / n, avg_wt / n);
}

/* --- Round Robin --- */
void round_robin(struct Process p[], int n, int quantum) {
    int count = 0, time = 0, i, flag;
    float avg_wt = 0, avg_tat = 0;
    for (i = 0; i < n; i++) p[i].temp_bt = p[i].bt;
    printf("\n--- Round Robin Results (Q:%d) ---\nPID\tAT\tBT\tCT\tTAT\tWT\n", quantum);
    while (count != n) {
        flag = 0;
        for (i = 0; i < n; i++) {
            if (p[i].at <= time && p[i].temp_bt > 0) {
                flag = 1;
                if (p[i].temp_bt > quantum) {
                    time += quantum;
                    p[i].temp_bt -= quantum;
                } else {
                    time += p[i].temp_bt;
                    p[i].temp_bt = 0;
                    count++;
                    p[i].ct = time;
                    p[i].tat = p[i].ct - p[i].at;
                    p[i].wt = p[i].tat - p[i].bt;
                    avg_tat += p[i].tat; avg_wt += p[i].wt;
                    printf("P[%d]\t%d\t%d\t%d\t%d\t%d\n", p[i].pid, p[i].at, p[i].bt, p[i].ct, p[i].tat, p[i].wt);
                }
            }
        }
        if (flag == 0) time++;
    }
    printf("Avg TAT: %.2f, Avg WT: %.2f\n", avg_tat / n, avg_wt / n);
}
